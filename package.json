{
  "name": "seznam-skol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:validate": "prisma validate --config prisma7.config.ts",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts",
    "test:pilot": "node --test src/pilot/*.node-tests.mjs",
    "pilot:export": "node src/pilot/cli.mjs",
    "profiles:script": "node src/pilot/browser-profiles.mjs",
    "batch:prepare": "node --import tsx src/batch/prepare.mjs",
    "batch:scan": "node --import tsx src/batch/scan.mjs",
    "batch:browser": "node --import tsx src/batch/browser.mjs",
    "batch:export": "node --import tsx src/batch/export.mjs",
    "test:batch": "node --import tsx --test src/batch/*.node-tests.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "cheerio": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
